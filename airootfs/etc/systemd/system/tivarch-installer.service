[Unit]
Description=TiVarch OS Installer
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/share/tivarch-installer
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=TiVarch
ExecStart=/usr/local/bin/tivarch-installer
Restart=on-failure
RestartSec=1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=graphical.target
